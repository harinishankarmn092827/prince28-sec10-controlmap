# Application Configuration
APP_NAME=ControlMap
APP_ENV=development
DEBUG=false

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# LLM Configuration
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Database Configuration
DATABASE_URL=sqlite:///./controlmap.db

# LLM Gateway
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30
USD_INR=95
PROMPTS_DIR=prompts

# Async Ingestion Queue
REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=
WORKER_IN_API=false
INGEST_CONCURRENCY=2
INGEST_RPM=12.0
INGEST_JOB_TIMEOUT=60
INGEST_MAX_TRIES=3
